update user_role_client urc set tourney_id = (select tourney_id from tourney_urc turc where urc.id=turc.urc_id );


ALTER TABLE tourney ADD discipline_id int4 NULL;

ALTER TABLE ONLY tourney
    ADD CONSTRAINT tourney_discipline_id_fk 
    FOREIGN KEY (discipline_id) REFERENCES discipline(id)
  	ON UPDATE NO ACTION 
  	ON DELETE NO ACTION 
  	DEFERRABLE INITIALLY IMMEDIATE;
  	
ALTER TABLE user_role_client DROP COLUMN discipline_id;
drop table tourney_urc;

  	