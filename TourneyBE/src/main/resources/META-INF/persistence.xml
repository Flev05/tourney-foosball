<?xml version="1.0" encoding="UTF-8"?>
<persistence 
	xmlns="http://java.sun.com/xml/ns/persistence" 
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
	version="2.0">
	
	<persistence-unit name="TourneyPU" transaction-type="JTA">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<jta-data-source>java:/TourneyDS</jta-data-source>
		
		<class>it.lms.cb.po.RoleType</class>
		<class>it.lms.cb.po.AbstractRole</class>
		<class>it.lms.cb.po.Role</class>
		<class>it.lms.cb.po.User</class>
		<class>it.lms.cb.po.Resource</class>
		<class>it.lms.cb.po.Permission</class>
		<class>it.lms.cb.po.Person</class>
		<class>it.lms.cb.po.ActivityLog</class>

		<class>it.lms.cb.po.AbstractCompany</class>
		<class>it.lms.cb.po.Company</class>
		
		<class>it.lms.cb.cmt.model.Customer</class>
		<class>it.lms.cb.cmt.model.LogMessage</class>
									
		<properties>
            <property name="hibernate.dialect" 		value="org.hibernate.dialect.PostgreSQL9Dialect"/>
            <property name="hibernate.show_sql" 	value="false"/>
            <property name="hibernate.format_sql" 	value="true"/>
		</properties>
		
	</persistence-unit>
</persistence>
