<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration debug="true"
	xmlns:log4j="http://jakarta.apache.org/log4j/">
	
	<appender name="OUTPUT" class="org.apache.log4j.RollingFileAppender">
		<param name="file" value="/var/erebus/logs/tourney/${running.environment}/tourney.log" />
		<param name="MaxFileSize" value="10MB" />
		<param name="MaxBackupIndex" value="100" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d[%-5p][%t] %C{1} - %m%n" />
		</layout>
	</appender>

	<appender name="stdout" class="org.apache.log4j.ConsoleAppender">
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d[%-5p][%t] %C{1} - %m%n" />
			<!-- param name="ConversionPattern" value="%d{ABSOLUTE} %5p %c{1}:%L - %m%n" / -->
		</layout>
	</appender>

	<logger name="it.lms.tourney" additivity="false">
		<level value="debug" />
		<appender-ref ref="OUTPUT" />
		<appender-ref ref="stdout" />
	</logger>

	<logger name="it.lms.tourney.dao" additivity="false">
		<level value="debug" />
		<appender-ref ref="OUTPUT" />
		<appender-ref ref="stdout" />
	</logger>

	<root>
		<priority value="error" />
		<appender-ref ref="OUTPUT" />
		<appender-ref ref="stdout" />
	</root>
 
</log4j:configuration>
  